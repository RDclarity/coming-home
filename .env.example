# Optionaler eigener Formular-Endpoint (Formspree, Basin, n8n, …). Meist
# NICHT nötig – siehe VITE_LEAD_NOTIFY_ENDPOINT weiter unten, das ist der
# eigentliche Weg für die automatische E-Mail-Benachrichtigung.
VITE_FORM_ENDPOINT=

# URL der Supabase Edge Function für die automatische E-Mail-Benachrichtigung
# an anfrage@jasmindraxl.at bei jeder neuen Anfrage, siehe
# supabase/functions/notify-lead/. Ohne diese URL (und ohne
# VITE_FORM_ENDPOINT oben) öffnet sich beim Absenden stattdessen ein
# vorbereiteter E-Mail-Entwurf im Postfach der besuchenden Person.
VITE_LEAD_NOTIFY_ENDPOINT=

# Supabase-Projekt fürs CRM (eigenes Projekt "coming-home", getrennt von
# allen anderen Ventures). Ohne diese beiden Werte fällt das CRM auf
# localStorage zurück (siehe src/crm/store.ts) – die Seite baut also auch
# ohne Supabase weiter, nur eben nicht mit zentralem Backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tracking (Google Analytics, Google Ads, Meta Pixel) – siehe README-Abschnitt
# "Tracking". Jedes Tool bleibt einzeln aus, solange seine ID hier leer ist.
# Alle drei laden zusätzlich erst NACH Cookie-Zustimmung (ConsentBanner.tsx).
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_META_PIXEL_ID=

# URL der Supabase Edge Function für serverseitiges Conversion-Tracking
# (Meta Conversions API + GA4 Measurement Protocol), siehe
# supabase/functions/send-conversion/. Optional – ohne diese URL läuft nur
# das normale Browser-Pixel/gtag, ohne die serverseitige Ergänzung.
VITE_CONVERSION_ENDPOINT=

# Frontend-Fehler-Tracking (Sentry), siehe src/lib/errorTracking.ts. Ohne
# diesen Wert läuft kein Sentry-Code, kein zusätzliches Bundle-Gewicht.
VITE_SENTRY_DSN=
